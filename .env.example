# ── Backend ─────────────────────────────────────────────────────
APP_ID=                   # Application ID
APP_SECRET=               # Application secret (used for JWT signing)

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=             # MySQL connection string (mysql://user:pass@host:port/db)

# ── Frontend (exposed to browser via Vite) ──────────────────────
VITE_KIMI_AUTH_URL=       # Kimi OAuth server URL (e.g. https://auth.kimi.com)
VITE_APP_ID=              # OAuth application ID

# ── Backend (Auth) ─────────────────────────────────────────────
KIMI_AUTH_URL=            # Kimi OAuth server URL (backend)
KIMI_OPEN_URL=            # Kimi Open Platform URL (e.g. https://open.kimi.com)

# ── Admin Role ──────────────────────────────────────────────────
OWNER_UNION_ID=           # Union ID of the app creator; this user gets role "admin" on first login

# ── Sign-in (own accounts) ─────────────────────────────────────
OWNER_EMAIL=              # this email becomes admin when it signs up or signs in with Google
PUBLIC_URL=               # e.g. https://yourdomain.com (used in reset links and Google redirect)
GOOGLE_CLIENT_ID=         # optional: enables the Google sign-in button
GOOGLE_CLIENT_SECRET=     # optional
# Google redirect URI to register: <PUBLIC_URL or http://localhost:3000>/api/auth/google/callback

# ── Email (real emails for password reset and the contact form) ─
RESEND_API_KEY=          # from resend.com; without it, emails are printed in the server console instead
EMAIL_FROM=              # e.g. Hospitalityservis <hello@yourdomain.com> (a domain verified in Resend)
CONTACT_INBOX=           # where contact and vendor enquiries are delivered

# ── Stripe Payment Links (Stripe Dashboard > Payment Links) ────
# Paste the https://buy.stripe.com/... URLs. Leave empty and the plan button opens the contact form instead.
VITE_CHECKOUT_PRO_MONTHLY=
VITE_CHECKOUT_PRO_YEARLY=

# ── Payments (Stripe; needs a Stripe account for a US/UK company) ─
STRIPE_SECRET_KEY=       # sk_live_... (use sk_test_... while testing)
STRIPE_WEBHOOK_SECRET=   # whsec_... from the webhook endpoint you add in Stripe
STRIPE_PRICE_PRO=        # price_... for the Pro monthly plan
STRIPE_PRICE_PRO_YEARLY= # price_... for the Pro yearly plan (optional)
# Stripe webhook URL: <PUBLIC_URL>/api/stripe/webhook  (events: checkout.session.completed, customer.subscription.updated, customer.subscription.deleted)

# ── Payment methods ─────────────────────────────────────────────
# Leave STRIPE_PAYMENT_METHODS empty to show every method you switch on in Stripe Dashboard > Settings > Payment methods
# (cards, Apple Pay, Google Pay, Link, PayPal, Cash App Pay, Amazon Pay, Revolut Pay, ACH, SEPA, Bacs, iDEAL, Bancontact, EPS, ...).
# Or force a list, e.g. card,link,paypal,us_bank_account,sepa_debit
STRIPE_PAYMENT_METHODS=
# Extra pay-by links (optional). Empty = the button becomes "request an invoice".
PAY_LINK_PAYPAL=         # https://www.paypal.com/ncp/payment/... or PayPal.me link
PAY_LINK_WISE=           # Wise payment request link
PAY_LINK_CRYPTO=         # hosted crypto checkout link (Coinbase Commerce, NOWPayments, ...)
PAY_LINK_JAZZCASH=
PAY_LINK_EASYPAISA=
# Also add checkout.session.async_payment_succeeded to the Stripe webhook events (needed for bank debits).
